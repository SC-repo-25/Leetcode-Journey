class Solution {
    public int maximalRectangle(char[][] matrix) {
        if (matrix.length == 0) return 0;

        int n = matrix[0].length;
        int[] h = new int[n];
        int ans = 0;

        for (char[] row : matrix) {
            for (int j = 0; j < n; j++) {
                h[j] = row[j] == '1' ? h[j] + 1 : 0;
            }

            ans = Math.max(ans, largestRectangle(h));
        }

        return ans;
    }

    private int largestRectangle(int[] h) {
        int n = h.length;
        int[] stack = new int[n + 1];
        int top = -1;
        int max = 0;

        for (int i = 0; i <= n; i++) {
            int cur = (i == n) ? 0 : h[i];

            while (top >= 0 && h[stack[top]] > cur) {
                int height = h[stack[top--]];
                int width = top < 0 ? i : i - stack[top] - 1;
                max = Math.max(max, height * width);
            }

            stack[++top] = i;
        }

        return max;
    }
}
