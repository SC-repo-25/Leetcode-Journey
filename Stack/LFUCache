import java.util.*;

class LFUCache {

    class Node {
        int key, value, freq;
        Node prev, next;

        Node(int key, int value) {
            this.key = key;
            this.value = value;
            freq = 1;
        }
    }

    class DLL {
        Node head, tail;
        int size;

        DLL() {
            head = new Node(0, 0);
            tail = new Node(0, 0);
            head.next = tail;
            tail.prev = head;
        }

        void add(Node node) {
            node.next = head.next;
            node.prev = head;
            head.next.prev = node;
            head.next = node;
            size++;
        }

        void remove(Node node) {
            node.prev.next = node.next;
            node.next.prev = node.prev;
            size--;
        }

        Node removeLast() {
            if (size == 0) return null;
            Node node = tail.prev;
            remove(node);
            return node;
        }
    }

    private final int capacity;
    private int size;
    private int minFreq;

    private final Map<Integer, Node> nodes = new HashMap<>();
    private final Map<Integer, DLL> freqMap = new HashMap<>();

    public LFUCache(int capacity) {
        this.capacity = capacity;
    }

    public int get(int key) {
        if (!nodes.containsKey(key))
            return -1;

        Node node = nodes.get(key);
        increaseFreq(node);
        return node.value;
    }

    public void put(int key, int value) {
        if (capacity == 0)
            return;

        if (nodes.containsKey(key)) {
            Node node = nodes.get(key);
            node.value = value;
            increaseFreq(node);
            return;
        }

        if (size == capacity) {
            DLL list = freqMap.get(minFreq);
            Node removed = list.removeLast();
            nodes.remove(removed.key);
            size--;
        }

        Node node = new Node(key, value);
        nodes.put(key, node);

        freqMap.computeIfAbsent(1, k -> new DLL()).add(node);

        minFreq = 1;
        size++;
    }

    private void increaseFreq(Node node) {
        int freq = node.freq;

        DLL oldList = freqMap.get(freq);
        oldList.remove(node);

        if (freq == minFreq && oldList.size == 0)
            minFreq++;

        node.freq++;

        freqMap.computeIfAbsent(node.freq, k -> new DLL()).add(node);
    }
}
