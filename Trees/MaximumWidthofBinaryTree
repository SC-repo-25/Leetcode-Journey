class Solution {
    public int widthOfBinaryTree(TreeNode root) {

        if (root == null)
            return 0;

        Deque<Pair<TreeNode, Long>> q = new ArrayDeque<>();
        q.offer(new Pair<>(root, 0L));

        int ans = 0;

        while (!q.isEmpty()) {

            int size = q.size();
            long start = q.peekFirst().getValue();
            long end = start;

            for (int i = 0; i < size; i++) {

                Pair<TreeNode, Long> pair = q.poll();
                TreeNode node = pair.getKey();
                long index = pair.getValue() - start;

                end = index;

                if (node.left != null)
                    q.offer(new Pair<>(node.left, 2 * index));

                if (node.right != null)
                    q.offer(new Pair<>(node.right, 2 * index + 1));
            }

            ans = Math.max(ans, (int) (end + 1));
        }

        return ans;
    }
}
