class Solution {
    public List<List<Integer>> combinationSum3(int k, int n) {
        List<List<Integer>> ans = new ArrayList<>();
        backtrack(1, k, n, 0, new ArrayList<>(), ans);
        return ans;
    }

    void backtrack(int start, int k, int target, int sum,
                   List<Integer> curr, List<List<Integer>> ans) {

        if (curr.size() == k) {
            if (sum == target)
                ans.add(new ArrayList<>(curr));
            return;
        }

        if (sum > target)
            return;

        for (int i = start; i <= 9; i++) {
            curr.add(i);

            backtrack(i + 1, k, target, sum + i, curr, ans);

            curr.remove(curr.size() - 1);
        }
    }
}
